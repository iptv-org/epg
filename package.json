{
  "name": "epg",
  "scripts": {
    "act:check": "act pull_request -W .github/workflows/check.yml",
    "act:format": "act workflow_dispatch -W .github/workflows/format.yml",
    "act:update": "act workflow_dispatch -W .github/workflows/update.yml",
    "api:load": "node -r @swc-node/register scripts/commands/api/load.ts",
    "channels:lint": "node -r @swc-node/register scripts/commands/channels/lint.mts",
    "channels:parse": "node -r @swc-node/register scripts/commands/channels/parse.ts",
    "channels:format": "node -r @swc-node/register scripts/commands/channels/format.ts",
    "channels:edit": "node -r @swc-node/register scripts/commands/channels/edit.ts",
    "channels:validate": "node -r @swc-node/register scripts/commands/channels/validate.ts",
    "sites:init": "node -r @swc-node/register scripts/commands/sites/init.ts",
    "sites:update": "node -r @swc-node/register scripts/commands/sites/update.ts",
    "guides:update": "node -r @swc-node/register scripts/commands/guides/update.ts",
    "guides:export": "node -r @swc-node/register scripts/commands/guides/export.ts",
    "workers:load": "node -r @swc-node/register scripts/commands/workers/load.ts",
    "grab": "node -r @swc-node/register scripts/commands/epg/grab.ts",
    "lint": "npx eslint \"{scripts,tests,sites}/**/*.{ts,mts,js}\"",
    "test": "cross-env TZ=Pacific/Nauru npx jest --runInBand",
    "postinstall": "npm run api:load",
    "prepare": "husky"
  },
  "private": true,
  "license": "UNLICENSED",
  "jest": {
    "transform": {
      "^.+\\.(ts|js)$": "@swc/jest"
    },
    "testMatch": [
      "<rootDir>/sites/**/*.test.(js|ts)",
      "<rootDir>/tests/commands/**/*.test.(js|ts)"
    ],
    "testTimeout": 10000,
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!parse-duration/.*|@freearhey/core/.*|glob/.*|srcset/.*|balanced-match/.*|minimatch/.*)"
    ]
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.18.0",
    "@freearhey/chronos": "^0.0.1",
    "@freearhey/core": "^0.16.1",
    "@freearhey/search-js": "^0.3.0",
    "@freearhey/storage-js": "^0.2.0",
    "@inquirer/prompts": "^8.7.4",
    "@iptv-org/sdk": "^1.5.0",
    "@ntlab/awswaf": "^1.0.1",
    "@ntlab/sfetch": "^1.5.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/jest": "^0.2.36",
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^29.5.12",
    "@types/langs": "^2.0.5",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.orderby": "^4.6.9",
    "@types/lodash.sortby": "^4.7.9",
    "@types/lodash.startcase": "^4.4.9",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/node": "^18.19.0",
    "@types/pako": "^2.0.4",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "cross-env": "^7.0.3",
    "csv-parser": "^3.0.0",
    "curl-generator": "^0.5.0",
    "dayjs": "^1.11.13",
    "epg-grabber": "^0.48.0",
    "epg-parser": "^0.5.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "fs-extra": "^11.3.0",
    "glob": "^10.4.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "iconv-lite": "^0.6.3",
    "inquirer": "^9.3.7",
    "jest": "^29.7.0",
    "langs": "^2.0.0",
    "libxml2-wasm": "^0.7.1",
    "lodash.merge": "^4.6.2",
    "lodash.orderby": "^4.18.0",
    "lodash.sortby": "^4.7.0",
    "lodash.startcase": "^4.4.0",
    "lodash.uniqby": "^4.7.0",
    "p-limit": "^5.0.0",
    "pako": "^2.1.0",
    "parse-duration": "^2.1.8",
    "pm2": "^5.4.2",
    "serve": "^14.2.4",
    "socks-proxy-agent": "^8.0.4",
    "srcset": "^5.0.3",
    "table2array": "^0.0.2",
    "tabletojson": "^4.1.12",
    "tough-cookie": "^4.1.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.20.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18"
  },
  "overrides": {
    "esbuild": "0.23.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}